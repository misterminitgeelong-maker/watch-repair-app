# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit real credentials.

# Off by default. Set true ONLY for the first-tenant bootstrap, then turn it off again.
ALLOW_PUBLIC_BOOTSTRAP=false

# One-time startup seed (imports a CSV only when the DB has no repair jobs).
# OFF by default. The customer CSV is NOT in the repo (seed/repairs_import.csv is gitignored);
# if STARTUP_SEED_ENABLED=true and the file is absent, the seed is skipped.
STARTUP_SEED_ENABLED=false
STARTUP_SEED_CSV_PATH=seed/repairs_import.csv
STARTUP_SEED_TENANT_SLUG=
STARTUP_SEED_TENANT_NAME=
STARTUP_SEED_OWNER_EMAIL=
STARTUP_SEED_OWNER_PASSWORD=

# Optional testing tenant (internal QA only; never in production).
# When all three are set, a testing tenant is created at startup.
# ALLOW_ENSURE_TESTING_TENANT=true enables POST /auth/ensure-testing-tenant (force-create).
TESTING_TENANT_SLUG=
TESTING_OWNER_EMAIL=
TESTING_OWNER_PASSWORD=
ALLOW_ENSURE_TESTING_TENANT=false

# Optional global platform admin (cross-tenant visibility)
# Login: shop number = "platform", email + password as set below
# OFF by default. If enabled, set a unique password of 12+ characters.
PLATFORM_ADMIN_ENABLED=false
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_FULL_NAME=Platform Admin
PLATFORM_ADMIN_TENANT_SLUG=platform
PLATFORM_ADMIN_TENANT_NAME=Platform

# Twilio SMS (quote approvals, arrival notifications, etc.). E.164 format for numbers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Twilio SendGrid email (Console → Email → API Keys). Separate from TWILIO_ACCOUNT_SID above.
ENABLE_EMAIL_NOTIFICATIONS=false
SENDGRID_API_KEY=
EMAIL_FROM_ADDRESS=noreply@mainspring.au
EMAIL_FROM_NAME=Mainspring
EMAIL_REPLY_TO_ADDRESS=admin@mainspring.au

# Stripe — same STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET for SaaS checkout and webhooks.
# Webhooks: customer.subscription.*, checkout.session.completed (Mobile invoices), and account.updated (Connect).
# Enable Stripe Connect in the Dashboard. Per-shop Mobile invoice card payments are direct charges on each
# shop's Connect Express account (the shop pays Stripe's fee). Add a second webhook endpoint in Stripe with
# "Events on connected accounts" (checkout.session.completed, account.updated), same URL, and put its secret here:
# STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
# STRIPE_CONNECT_DEFAULT_COUNTRY=AU
ENABLE_STRIPE_INVOICE_CHECKOUT=true
# Locked 2026-09 ladder — create NEW Prices in Stripe (test, then live). Do not reuse old Basic/Pro IDs for new signups.
# STRIPE_PRICE_SHOP=price_...          # A$50/mo one location, all tabs
# STRIPE_PRICE_PRO=price_...           # A$90/mo multi-site
# STRIPE_PRICE_PRO_LEGACY=price_...    # previous A$50 Pro ID (webhook mapping only)
# STRIPE_PRICE_EXTRA_LOCATION=price_... # A$25/mo extra site on a Pro subscription
# Keep legacy IDs set so existing subscribers stay mapped:
# STRIPE_PRICE_BASIC_BASE=
# STRIPE_PRICE_BASIC_ADDON_TAB=
# STRIPE_PRICE_WATCH=
# STRIPE_PRICE_SHOE=
# STRIPE_PRICE_AUTO_KEY=
# STRIPE_PRICE_ENTERPRISE=

# Xero — Mobile Services (Auto Key) invoice sync only. Register an app at https://developer.xero.com
# Redirect URI must match XERO_REDIRECT_URI (typically your API + /v1/billing/xero/callback).
# Webhook delivery URL: {API_BASE}/v1/webhooks/xero — use XERO_WEBHOOK_KEY for signature verification.
# Tokens are stored on the tenant row in the database; restrict DB access in production.
# XERO_CLIENT_ID=
# XERO_CLIENT_SECRET=
# XERO_REDIRECT_URI=https://your-api.example.com/v1/billing/xero/callback
# XERO_WEBHOOK_KEY=

# Full public URL of the frontend (used in SMS approval links)
PUBLIC_BASE_URL=https://mainspring.au

# Mobile Services: week/dispatch list filters and customer SMS use this IANA zone for “local” days (e.g. Australia/Sydney)
SCHEDULE_CALENDAR_TIMEZONE=Australia/Sydney

# Google Places API (optional — for Prospects search; leave blank to disable)
GOOGLE_PLACES_API_KEY=

# Google Maps Directions API — server-side driving order on Mobile Services → Map (leave blank to disable Driving mode)
# Can be the same GCP key as Places if Directions API is enabled for it.
# GOOGLE_MAPS_WEB_SERVICES_KEY=

# Google Maps JavaScript API key (for Mobile Services Map tab; Vite env — add to Railway as VITE_GOOGLE_MAPS_API_KEY)
# VITE_GOOGLE_MAPS_API_KEY=

# Large historic file imports (/v1/import/csv): if requests still time out, raise reverse-proxy idle/read timeouts (e.g. nginx proxy_read_timeout) above ~600s; the API client uses a 10-minute timeout for this route.
